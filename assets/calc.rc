#include "version.h"
1 ICON "calc.ico"
1 24 RUSTIC_MANIFEST_PATH
1 VERSIONINFO
 FILEVERSION RUSTIC_VERSION_QUAD
 PRODUCTVERSION RUSTIC_VERSION_QUAD
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Rustic Calc contributors\0"
   VALUE "FileDescription", "Rustic Calc\0"
   VALUE "FileVersion", RUSTIC_VERSION_STRING "\0"
   VALUE "InternalName", "RusticCalc\0"
   VALUE "LegalCopyright", "Copyright (c) 2026 Rustic Calc contributors\0"
   VALUE "OriginalFilename", "RusticCalc.exe\0"
   VALUE "ProductName", "Rustic Calc\0"
   VALUE "ProductVersion", RUSTIC_VERSION_STRING "\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
